{
  "name": "agentcubicle",
  "version": "0.0.2",
  "private": true,
  "description": "3D isometric office that visualizes local AI agent activity",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "node scripts/check-node.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "postinstall": "install-electron",
    "screenshots": "electron-vite build && playwright test -c playwright.visual.config.mts",
    "screenshots:sheet": "cd tests/visual/baseline/states && montage -label %t -pointsize 22 IDLE-closeup.png THINKING-closeup.png READ-closeup.png WRITE-closeup.png EXEC-closeup.png WAITING_APPROVAL-closeup.png COMPLETED-closeup.png ERROR-closeup.png STALE-closeup.png -tile 3x3 -geometry 420x380+6+6 -background \"#f1e5d3\" ../states-contact-sheet.png && mogrify -resize 50% ../states-contact-sheet.png",
    "sim": "tsx tools/simulator/cli.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "test:packaged": "playwright test -c playwright.packaged.config.mts",
    "soak": "tsx tools/soak/run.ts",
    "verify:claude": "tsx tools/verify/claude-real.ts",
    "icon": "tsx tools/icon/render.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chokidar": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postprocessing": "^6.39.5",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@12.8.1",
  "productName": "AgentCubicle",
  "author": "AgentCubicle",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
